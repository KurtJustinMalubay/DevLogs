@page "/"
@inject AuthService Auth
@inject UiState Ui
@inject LogService LogService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Home · DevLogs</PageTitle>

<section class="mb-[1.6rem]">
    <h1>@Greeting, @Auth.Current?.Username</h1>
    <p class="text-[#8b9dbf]">Here's your workspace. Capture something, or pick up a recent log.</p>
</section>

<section class="grid grid-cols-4 border border-[#243452] rounded-[10px] bg-[#131e32] mb-[1.6rem]" aria-label="This week at a glance">
    <div class="p-[1rem_1.3rem] grid gap-[.1rem]"><strong class="text-[1.5rem] tracking-[-.02em]">@LogsThisWeek</strong><span class="text-[#8b9dbf] text-[.85rem]">logs this week</span></div>
    <div class="p-[1rem_1.3rem] grid gap-[.1rem] border-l border-[#243452]"><strong class="text-[1.5rem] tracking-[-.02em]">@TotalSnippets</strong><span class="text-[#8b9dbf] text-[.85rem]">snippets saved</span></div>
    <div class="p-[1rem_1.3rem] grid gap-[.1rem] border-l border-[#243452]"><strong class="text-[1.5rem] tracking-[-.02em]">@OpenBugs</strong><span class="text-[#8b9dbf] text-[.85rem]">open bugs</span></div>
    <div class="p-[1rem_1.3rem] grid gap-[.1rem] border-l border-[#243452]"><strong class="text-[1.5rem] tracking-[-.02em]">@LoggingStreak days</strong><span class="text-[#8b9dbf] text-[.85rem]">logging streak</span></div>
</section>

<div class="grid grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] gap-[1.4rem] items-start">
    <div class="grid gap-[1.4rem]">
        <section class="bg-[#131e32] border border-[#243452] rounded-[10px] p-[1.2rem_1.3rem]">
            <h2>Quick capture</h2>
            <div class="flex flex-wrap gap-[.5rem] mb-[.9rem]" role="group" aria-label="Entry type">
                @foreach (var k in Kinds)
                {
                    <button class="p-[.3rem_.8rem] border border-[#243452] rounded-[999px] text-[.85rem] hover:text-[#e8eefb] hover:border-[#3a5078] @(kind == k ? "bg-[#5eead4] border-[#5eead4] text-[#04211d] font-semibold" : "text-[#8b9dbf]")" aria-pressed="@(kind == k ? "true" : "false")" @onclick="() => kind = k">@k</button>
                }
            </div>
            <textarea class="w-full resize-y min-h-[88px] p-[.8rem_.9rem] bg-[#0d1524] border border-[#243452] rounded-[10px] text-[#e8eefb] font-inherit focus:outline-none focus:border-[#5eead4]" rows="3" @bind="draft" @bind:event="oninput"
                      placeholder="What did you just figure out, fix, or break?"></textarea>
            <div class="flex justify-between items-center mt-[.8rem] text-[.85rem]">
                <span class="text-[#8b9dbf]">Markdown supported soon</span>
                <button class="inline-flex items-center justify-center gap-[.4rem] p-[.6rem_1.05rem] rounded-[10px] font-semibold border border-transparent transition-[filter,background] duration-150 bg-[#5eead4] text-[#04211d] hover:not(:disabled):brightness-108 hover:not(:disabled):no-underline disabled:opacity-45 disabled:cursor-not-allowed" disabled="@(string.IsNullOrWhiteSpace(draft))" @onclick="SaveLog">Save @kind.ToLower()</button>
            </div>
        </section>

        <section class="bg-[#131e32] border border-[#243452] rounded-[10px] p-[1.2rem_1.3rem]">
            <div class="flex justify-between items-baseline">
                <h2>Recent logs</h2>
                <button class="text-[#5eead4] text-[.875rem] hover:underline" @onclick='() => Nav.NavigateTo("/logs")'>View all</button>
            </div>
            <ul class="grid gap-[2px] m-[0_-.5rem]">
                @foreach (var e in Recent)
                {
                    <li>
                        <button class="grid grid-cols-[4.2rem_1fr_auto] gap-[.9rem] items-center w-full text-left p-[.7rem_.5rem] rounded-[8px] hover:bg-[#1a2843]" @onclick='() => Ui.Show("Log viewer")'>
                            <b class="font-semibold text-[.8rem] font-[var(--mono)] @(e.Kind switch { "log" => "text-[#5eead4]", "fix" => "text-[#ff9f7a]", "note" => "text-[#82a8ff]", "snippet" => "text-[#c4a1ff]", "idea" => "text-[#f5cd63]", "bug" => "text-[#ff7a8a]", _ => "" })">@e.Kind</b>
                            <span class="grid min-w-0">
                                <span class="font-semibold whitespace-nowrap overflow-hidden text-ellipsis">@e.Title</span>
                                <span class="text-[#8b9dbf] text-[.82rem]">@e.Project · @GetTimeAgo(e.CreatedAt)</span>
                            </span>
                            <span class="flex gap-[.5rem] text-[#8b9dbf] text-[.78rem] font-[var(--mono)]">@foreach (var t in e.Tags) { <em class="not-italic">#@t</em> }</span>
                        </button>
                    </li>
                }
            </ul>
            <p class="text-[#5d6f92] text-[.78rem] m-[.9rem_0_0]">Sample data for preview</p>
        </section>
    </div>

    <div class="grid gap-[1.4rem]">
        <section class="bg-[#131e32] border border-[#243452] rounded-[10px] p-[1.2rem_1.3rem]">
            <h2>Your last 18 weeks</h2>
            <div class="grid grid-rows-7 grid-flow-col gap-[4px]" role="img" aria-label="Activity heatmap">
                @foreach (var level in Cells) { <i class="aspect-square rounded-[3px] block @(level switch { 0 => "bg-[#182640]", 1 => "bg-[#155e57]", 2 => "bg-[#1f9a8c]", 3 => "bg-[#3cc9b6]", 4 => "bg-[#7df5e1]", _ => "" })"></i> }
            </div>
            <div class="flex gap-[4px] items-center justify-end mt-[.8rem] text-[#8b9dbf] text-[.75rem]"><span>Less</span><i class="w-[12px] aspect-square rounded-[3px] block bg-[#182640]"></i><i class="w-[12px] aspect-square rounded-[3px] block bg-[#155e57]"></i><i class="w-[12px] aspect-square rounded-[3px] block bg-[#1f9a8c]"></i><i class="w-[12px] aspect-square rounded-[3px] block bg-[#3cc9b6]"></i><i class="w-[12px] aspect-square rounded-[3px] block bg-[#7df5e1]"></i><span>More</span></div>
        </section>

        <section class="bg-[#131e32] border border-[#243452] rounded-[10px] p-[1.2rem_1.3rem]">
            <h2>Jump to</h2>
            <div class="flex flex-wrap gap-[.5rem] mb-[.9rem]">
                @foreach (var t in Tags)
                {
                    <button class="p-[.3rem_.8rem] border border-[#243452] rounded-[999px] text-[#8b9dbf] text-[.85rem] hover:text-[#e8eefb] hover:border-[#3a5078]" @onclick='() => Nav.NavigateTo($"/logs?tag={t}")'>#@t</button>
                }
            </div>
        </section>
    </div>
</div>

@code {
    static readonly string[] Kinds = ["Log", "Fix", "Snippet", "Idea"];
    IEnumerable<string> Tags => LogService.GetAllLogs().SelectMany(l => l.Tags).Distinct().Take(15);

    IEnumerable<LogEntry> Recent => LogService.GetRecentLogs(5);

    int[] Cells
    {
        get
        {
            var today = DateTime.Today;
            var start = today.AddDays(-125);
            var logs = LogService.GetAllLogs().Where(l => l.CreatedAt >= start).GroupBy(l => l.CreatedAt.Date).ToDictionary(g => g.Key, g => g.Count());
            return Enumerable.Range(0, 126).Select(i => 
            {
                var d = start.AddDays(i);
                if (!logs.TryGetValue(d, out int count)) return 0;
                return count > 3 ? 4 : count;
            }).ToArray();
        }
    }

    string kind = "Log";
    string draft = "";

    void SaveLog()
    {
        if (string.IsNullOrWhiteSpace(draft)) return;
        LogService.AddLog(kind, draft);
        draft = "";
    }

    static string Greeting => DateTime.Now.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };

    int LogsThisWeek => LogService.GetAllLogs().Count(l => l.CreatedAt >= DateTime.Now.AddDays(-7));
    int TotalSnippets => LogService.GetAllLogs().Count(l => l.Kind == "snippet");
    int OpenBugs => LogService.GetAllLogs().Count(l => l.Kind == "bug");
    
    int LoggingStreak
    {
        get
        {
            var dates = LogService.GetAllLogs().Select(l => l.CreatedAt.Date).Distinct().OrderByDescending(d => d).ToList();
            if (!dates.Any()) return 0;
            
            var streak = 0;
            var current = DateTime.Today;
            
            if (dates[0] != current && dates[0] != current.AddDays(-1)) return 0;
            if (dates[0] == current) streak++;
            
            for (int i = dates[0] == current ? 1 : 0; i < dates.Count; i++)
            {
                if (dates[i] == current.AddDays(-streak)) streak++;
                else break;
            }
            return streak;
        }
    }

    string GetTimeAgo(DateTime time) 
    {
        var span = DateTime.Now - time;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} h ago";
        return $"{(int)span.TotalDays} days ago";
    }

    protected override void OnInitialized() => LogService.OnLogAdded += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => LogService.OnLogAdded -= Refresh;
}
