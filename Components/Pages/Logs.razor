@page "/logs"
@inject AuthService Auth
@inject LogService LogService
@implements IDisposable

<PageTitle>All Logs · DevLogs</PageTitle>

<div class="mb-[1.6rem]">
    <h1 class="text-[1.75rem] font-bold leading-[1.2] mb-[0.4rem] tracking-[-0.02em]">All Logs</h1>
    <p class="text-[#8b9dbf] mb-[1rem]">Browse and filter through your entire logging history.</p>
</div>

<div class="bg-[#131e32] border border-[#243452] rounded-[10px] p-[1.2rem_1.3rem]">
    <div class="flex flex-wrap gap-[0.5rem] mb-[0.9rem]">
        @foreach (var filter in new[] { "All", "Logs", "Bugs", "Snippets" })
        {
            var isSelected = activeFilter == filter;
            <button class="px-[0.8rem] py-[0.3rem] border rounded-full text-[0.85rem] transition-colors @(isSelected ? "border-[#5eead4] bg-[#5eead4] text-[#04211d] font-semibold" : "border-[#243452] text-[#8b9dbf] hover:text-[#e8eefb] hover:border-[#3a5078]")" @onclick="() => activeFilter = filter">@filter</button>
        }
    </div>

    <ul class="grid gap-[2px] -mx-[0.5rem]">
        @foreach (var e in LogService.GetAllLogs().Where(l => activeFilter == "All" || l.Kind.Equals(activeFilter.TrimEnd('s'), StringComparison.OrdinalIgnoreCase)))
        {
            <li>
                <button class="grid grid-cols-[4.2rem_1fr_auto] gap-[0.9rem] items-center w-full text-left p-[0.7rem_0.5rem] rounded-[8px] hover:bg-[#1a2843]">
                    <b class="font-mono font-semibold text-[0.8rem] @GetKindClass(e.Kind)">@e.Kind</b>
                    <span class="grid min-w-0">
                        <span class="font-semibold whitespace-nowrap overflow-hidden text-ellipsis">@e.Title</span>
                        <span class="text-[0.82rem] text-[#8b9dbf]">@e.Project · @e.CreatedAt.ToString("MMM dd")</span>
                    </span>
                    <span class="flex gap-[0.5rem] text-[#8b9dbf] font-mono text-[0.78rem]">
                        @foreach (var t in e.Tags) { <span>#@t</span> }
                    </span>
                </button>
            </li>
        }
    </ul>
</div>

@code {
    string activeFilter = "All";

    string GetKindClass(string kind) => kind switch
    {
        "fix" => "text-[#ff9f7a]",
        "note" => "text-[#82a8ff]",
        "snippet" => "text-[#c4a1ff]",
        "idea" => "text-[#f5cd63]",
        "bug" => "text-[#ff7a8a]",
        "log" => "text-[#5eead4]",
        _ => "text-[#8b9dbf]"
    };

    protected override void OnInitialized() => LogService.OnLogAdded += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => LogService.OnLogAdded -= Refresh;
}
