@page "/tags"
@inject LogService LogService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Tags · DevLogs</PageTitle>

<div class="mb-[1.6rem]">
    <h1 class="text-[1.75rem] font-bold leading-[1.2] mb-1 tracking-[-0.02em]">Tags</h1>
    <p class="text-[#8b9dbf]">Browse everything by topic.</p>
</div>

@{
    var tagGroups = LogService.GetAllTags()
        .Select(t => new {
            Tag = t,
            LogCount = LogService.GetAllLogs().Count(l => l.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)),
            BugCount  = LogService.GetAllBugs().Count(b => b.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)),
            SnipCount = LogService.GetAllSnippets().Count(s => s.Tags.Contains(t, StringComparer.OrdinalIgnoreCase))
        })
        .OrderByDescending(t => t.LogCount + t.BugCount + t.SnipCount)
        .ToList();
}

@if (!tagGroups.Any())
{
    <div class="bg-[#131e32] border border-[#243452] rounded-[10px] p-12 text-center text-[#8b9dbf]">
        <p class="text-3xl mb-3">#</p>
        <p class="font-semibold">No tags yet.</p>
        <p class="text-sm mt-1">Tags are created automatically when you add them to a log, bug, or snippet using #tagname.</p>
    </div>
}
else
{
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4">
        @foreach (var t in tagGroups)
        {
            var total = t.LogCount + t.BugCount + t.SnipCount;
            <button class="bg-[#131e32] border border-[#243452] rounded-[10px] p-4 text-left hover:border-[#5eead4] hover:bg-[#1a2843] transition-colors group" @onclick='() => Nav.NavigateTo($"/logs?tag={t.Tag}")'>
                <div class="font-mono font-semibold text-[#5eead4] text-[1.1rem] mb-2 group-hover:underline">#@t.Tag</div>
                <div class="text-[#8b9dbf] text-[0.82rem] grid gap-1">
                    @if (t.LogCount > 0) { <span>@t.LogCount log@(t.LogCount != 1 ? "s" : "")</span> }
                    @if (t.BugCount > 0) { <span>@t.BugCount bug@(t.BugCount != 1 ? "s" : "")</span> }
                    @if (t.SnipCount > 0) { <span>@t.SnipCount snippet@(t.SnipCount != 1 ? "s" : "")</span> }
                </div>
                <div class="mt-3 text-[0.78rem] font-semibold text-[#8b9dbf]">@total item@(total != 1 ? "s" : "") total</div>
            </button>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        LogService.OnLogAdded += Refresh;
        LogService.OnBugChanged += Refresh;
        LogService.OnSnippetChanged += Refresh;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LogService.OnLogAdded -= Refresh;
        LogService.OnBugChanged -= Refresh;
        LogService.OnSnippetChanged -= Refresh;
    }
}
