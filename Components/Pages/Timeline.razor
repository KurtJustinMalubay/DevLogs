@page "/timeline"
@inject LogService LogService
@implements IDisposable

<PageTitle>Timeline · DevLogs</PageTitle>

<div class="mb-[1.6rem]">
    <h1 class="text-[1.75rem] font-bold leading-[1.2] mb-1 tracking-[-0.02em]">Timeline</h1>
    <p class="text-[#8b9dbf]">A chronological history of all your activity.</p>
</div>

@{
    var allEntries = LogService.GetAllLogs()
        .Select(l => (Date: l.CreatedAt, Kind: l.Kind, Title: l.Title, Sub: l.Project, Tags: l.Tags))
        .Concat(LogService.GetAllBugs().Select(b => (Date: b.CreatedAt, Kind: "bug", Title: b.Title, Sub: b.Project, Tags: b.Tags)))
        .Concat(LogService.GetAllSnippets().Select(s => (Date: s.CreatedAt, Kind: "snippet", Title: s.Title, Sub: s.Language, Tags: s.Tags)))
        .OrderByDescending(e => e.Date)
        .GroupBy(e => e.Date.Date)
        .ToList();
}

@if (!allEntries.Any())
{
    <div class="bg-[#131e32] border border-[#243452] rounded-[10px] p-12 text-center text-[#8b9dbf]">
        <p class="text-3xl mb-3">◷</p>
        <p class="font-semibold">Nothing on the timeline yet.</p>
        <p class="text-sm mt-1">Start adding logs, bugs, or snippets to see your history here.</p>
    </div>
}
else
{
    <div class="grid gap-8">
        @foreach (var day in allEntries)
        {
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="font-semibold text-[0.9rem] text-[#e8eefb]">@FormatDate(day.Key)</span>
                    <div class="flex-1 h-px bg-[#243452]"></div>
                    <span class="text-[0.8rem] text-[#8b9dbf]">@day.Count() item@(day.Count() != 1 ? "s" : "")</span>
                </div>
                <div class="grid gap-2 pl-4 border-l-2 border-[#243452]">
                    @foreach (var e in day)
                    {
                        <div class="flex items-start gap-3 p-3 rounded-[8px] hover:bg-[#131e32] group transition-colors">
                            <div class="w-2 h-2 rounded-full mt-[0.4rem] shrink-0 @KindDotClass(e.Kind)"></div>
                            <div class="grid gap-0.5 min-w-0">
                                <span class="font-semibold text-[0.9rem] text-[#e8eefb] leading-snug">@e.Title</span>
                                <div class="flex items-center gap-2 text-[0.78rem] text-[#8b9dbf]">
                                    <span class="@KindTextClass(e.Kind) font-mono font-semibold">@e.Kind</span>
                                    <span>·</span>
                                    <span>@e.Sub</span>
                                    <span>·</span>
                                    <span>@e.Date.ToString("HH:mm")</span>
                                    @foreach (var t in e.Tags) { <span class="font-mono">#@t</span> }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    string FormatDate(DateTime d)
    {
        if (d == DateTime.Today) return "Today";
        if (d == DateTime.Today.AddDays(-1)) return "Yesterday";
        return d.ToString("dddd, MMMM d");
    }

    string KindDotClass(string kind) => kind switch
    {
        "fix"     => "bg-[#ff9f7a]",
        "note"    => "bg-[#82a8ff]",
        "snippet" => "bg-[#c4a1ff]",
        "idea"    => "bg-[#f5cd63]",
        "bug"     => "bg-[#ff7a8a]",
        "log"     => "bg-[#5eead4]",
        _         => "bg-[#8b9dbf]"
    };

    string KindTextClass(string kind) => kind switch
    {
        "fix"     => "text-[#ff9f7a]",
        "note"    => "text-[#82a8ff]",
        "snippet" => "text-[#c4a1ff]",
        "idea"    => "text-[#f5cd63]",
        "bug"     => "text-[#ff7a8a]",
        "log"     => "text-[#5eead4]",
        _         => "text-[#8b9dbf]"
    };

    protected override void OnInitialized()
    {
        LogService.OnLogAdded += Refresh;
        LogService.OnBugChanged += Refresh;
        LogService.OnSnippetChanged += Refresh;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LogService.OnLogAdded -= Refresh;
        LogService.OnBugChanged -= Refresh;
        LogService.OnSnippetChanged -= Refresh;
    }
}
