@inject UiState Ui
@implements IDisposable

@if (Ui.Feature is not null)
{
    <div class="scrim" @onclick="Ui.Close">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="dev-title" @onclick:stopPropagation>
            <div class="dialog-icon" aria-hidden="true">🚧</div>
            <h2 id="dev-title">@Ui.Feature is under development</h2>
            <p class="muted">We're still building this part of DevLogs. It will appear here soon.</p>
            <button class="btn primary" @onclick="Ui.Close">Got it</button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Ui.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Ui.Changed -= Refresh;
}
